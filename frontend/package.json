{
  "name": "we-guide-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.417.0",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "vite": "^5.4.11",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.weguide.ems",
    "productName": "WE GUIDE EMS",
    "directories": {
      "output": "../dist-exe"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "../backend/**/*",
      "!../backend/node_modules"
    ],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/logo.png"
    }
  }
}
